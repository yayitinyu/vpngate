[Unit]
Description=VPN Gate SOCKS5H node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vpngate
Environment=PYTHONPATH=/opt/vpngate
ExecStart=/usr/local/bin/vpngate up --watch
ExecStop=/usr/local/bin/vpngate down
Restart=on-failure
RestartSec=15
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
